{
  "name": "qristifier",
  "version": "0.1.0",
  "description": "Ubah payload QRIS (statis/dinamis) menjadi gambar siap cetak dan promosi dengan template yang bisa dikustom — TypeScript, SVG, PNG.",
  "keywords": ["qris", "qr", "qr-code", "indonesia", "payment", "standee", "gpn", "template", "svg"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suriyadi15/qristifier.git",
    "directory": "packages/qristifier"
  },
  "homepage": "https://qristifier.pages.dev",
  "bugs": "https://github.com/suriyadi15/qristifier/issues",
  "funding": [
    { "type": "github", "url": "https://github.com/sponsors/suriyadi15" },
    { "type": "individual", "url": "https://trakteer.id/suriyadi15/tip" }
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./png": {
      "import": { "types": "./dist/png.d.mts", "default": "./dist/png.mjs" },
      "require": { "types": "./dist/png.d.cts", "default": "./dist/png.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE", "DISCLAIMER.md"],
  "scripts": {
    "build": "tsdown src/index.ts src/png.ts --format esm,cjs --dts --clean",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run build"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {
    "qrisnamis": "latest",
    "uqr": "latest"
  },
  "devDependencies": {
    "tsdown": "latest",
    "typescript": "~5.9.0",
    "@types/bun": "latest",
    "@resvg/resvg-wasm": "latest"
  },
  "peerDependencies": {
    "@resvg/resvg-wasm": ">=2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-wasm": { "optional": true }
  }
}
